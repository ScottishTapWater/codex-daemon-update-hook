#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin

confirm_restart() {
    local user=$1 amber='' bold='' reset='' answer=''
    if ! { exec 3<>/dev/tty; } 2>/dev/null; then
        printf 'Codex daemon update for %s skipped: no interactive terminal.\n' "$user"
        return 1
    fi
    if [[ ${TERM:-dumb} != dumb && ! -v NO_COLOR ]]; then
        amber=$'\e[1;33m' bold=$'\e[1m' reset=$'\e[0m'
    fi
    printf '\n%s============================================================%s\n' "$amber" "$reset" >&3
    printf '%s  CODEX BACKGROUND DAEMON UPDATE: %s%s\n' "$amber" "$user" "$reset" >&3
    printf '%s============================================================%s\n\n' "$amber" "$reset" >&3
    printf '%s\n' 'Codex has been upgraded, but its background daemon is still using' 'the previous version.' '' >&3
    printf '%sUpdating it will interrupt active daemon sessions.%s\n\n' "$amber" "$reset" >&3
    printf '%sUpdate and restart the daemon now? [y/N] %s' "$bold" "$reset" >&3
    IFS= read -r answer <&3 || answer=''
    printf '\n' >&3
    exec 3>&-
    [[ $answer =~ ^([yY]|[yY][eE][sS])$ ]]
}

process_user() {
    local user=$1 account name _password uid gid _gecos home _shell unit
    if [[ ! $user =~ ^[a-zA-Z_][a-zA-Z0-9_.-]*[$]?$ ]] || ! account=$(getent passwd "$user"); then
        printf 'Invalid or unknown account: %s\n' "$user" >&2
        return 1
    fi
    IFS=: read -r name _password uid gid _gecos home _shell <<<"$account"
    if [[ $name != "$user" || $uid == 0 || ! $uid =~ ^[0-9]+$ || ! $gid =~ ^[0-9]+$ || $home != /* ]]; then
        printf 'Unsupported account: %s (requires a non-root account with an absolute home directory).\n' "$user" >&2
        return 1
    fi
    [[ -f $home/.codex/packages/app-server-daemon/current/codex-package.json ]] || return 0
    if cmp -s /usr/lib/openai-codex/codex-package.json "$home/.codex/packages/app-server-daemon/current/codex-package.json"; then
        printf 'Codex daemon package for %s already matches the installed CLI.\n' "$user"
        return 0
    fi
    if pgrep -u "$uid" -f '(^|/)codex app-server .*--managed-daemon([[:space:]]|$)' >/dev/null; then
        if ! confirm_restart "$user"; then
            printf 'Codex daemon update for %s skipped. Run as that user from an independent terminal:\n  codex app-server daemon update --from-cli -y\n' "$user"
            return 0
        fi
    fi
    unit="codex-daemon-update-hook-$uid"
    # A transient service survives shutdown of a daemon hosting the caller.
    # The fixed unit name also prevents concurrent updates for the same account.
    if ! systemd-run --quiet --collect --wait --service-type=exec \
        --unit="$unit" --uid="$uid" --gid="$gid" \
        --working-directory="$home" --setenv="HOME=$home" \
        --setenv="XDG_RUNTIME_DIR=/run/user/$uid" \
        --setenv="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" \
        /usr/bin/codex app-server daemon update --from-cli -y; then
        printf 'Codex daemon update for %s failed. Inspect: sudo journalctl -u %s.service\n' "$user" "$unit" >&2
        return 1
    fi
    printf 'Codex daemon package for %s updated to match the installed CLI.\n' "$user"
}

process_config() {
    local config=$1 line user extra status=0
    local -A seen=()
    [[ -f $config ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%%#*}
        read -r user extra <<<"$line"
        [[ -n $user ]] || continue
        if [[ -n $extra ]]; then
            printf 'Expected one username per line: %s\n' "$line" >&2
            status=1
            continue
        fi
        [[ -z ${seen[$user]+present} ]] || continue
        seen[$user]=1
        if ! process_user "$user"; then status=1; fi
    done <"$config"
    return "$status"
}

main() {
    if (( EUID != 0 )); then
        printf '%s\n' 'This helper must run as root through pacman.' >&2
        return 1
    fi
    process_config /etc/codex-daemon-update-hook/users
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
